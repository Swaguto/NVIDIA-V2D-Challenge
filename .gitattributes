# Universal LFS rules (used by 2+ packages). Package-specific path rules
# live in each subproject's own .gitattributes.
docs/team/reproduction/dex3-motion-replay/support-height-uncertainty-probe-v1.py -text

# 3D mesh formats
*.obj filter=lfs diff=lfs merge=lfs -text
*.glb filter=lfs diff=lfs merge=lfs -text
*.stl filter=lfs diff=lfs merge=lfs -text
*.STL filter=lfs diff=lfs merge=lfs -text
*.mtl filter=lfs diff=lfs merge=lfs -text
*.dae filter=lfs diff=lfs merge=lfs -text
# Universal Scene Description (USD)
*.usd filter=lfs diff=lfs merge=lfs -text
*.usda filter=lfs diff=lfs merge=lfs -text
*.usdc filter=lfs diff=lfs merge=lfs -text
*.usdz filter=lfs diff=lfs merge=lfs -text
# Motion data
*.h5 filter=lfs diff=lfs merge=lfs -text
*.hdf5 filter=lfs diff=lfs merge=lfs -text
*.parquet filter=lfs diff=lfs merge=lfs -text
# NumPy / Pickle data
*.npy filter=lfs diff=lfs merge=lfs -text
*.npz filter=lfs diff=lfs merge=lfs -text
*.pkl filter=lfs diff=lfs merge=lfs -text
*.pickle filter=lfs diff=lfs merge=lfs -text
# Model weights
*.onnx filter=lfs diff=lfs merge=lfs -text
*.pt filter=lfs diff=lfs merge=lfs -text
*.safetensors filter=lfs diff=lfs merge=lfs -text

# The episode refinement entrypoint runs in Linux/WSL even from Windows checkouts.
scripts/track3/refine_episode.sh text eol=lf

# The clearance fixture verifies this method's exact bytes on Windows and Linux.
scripts/reproduction/_frozen_material_boundary_v1.py text eol=lf
scripts/reproduction/verify_dex3_clearance_counterexample.py text eol=lf
scripts/reproduction/reproduce_corrected_dex3_motion.py text eol=lf
scripts/reproduction/verify_corrected_dex3_certificate.py text eol=lf
# Preserve the actual measured receipt bytes and their recorded SHA256 values.
docs/team/reproduction/dex3-motion-replay/corrected-*.json -text whitespace=cr-at-eol
# These small numerical test fixtures are stored directly with the review code.
docs/team/reproduction/dex3-motion-replay/continuous-counterexample*.npz -filter -diff -merge -text
# These measured audit entrypoints are bound by raw hashes in the audit archive.
scripts/reproduction/audit_frozen_dex3_original_contacts.py -text whitespace=cr-at-eol
scripts/reproduction/audit_frozen_dex3_original_mesh_intersections.py -text whitespace=cr-at-eol
scripts/reproduction/audit_frozen_dex3_support_plane.py -text whitespace=cr-at-eol
scripts/reproduction/reproduce_CAD_dex3_motion.py -text whitespace=cr-at-eol
scripts/reproduction/verify_CAD_dex3_certificate.py -text whitespace=cr-at-eol
docs/team/reproduction/dex3-motion-replay/CAD-*.json -text whitespace=cr-at-eol
docs/team/reproduction/dex3-motion-replay/support-*.json -text whitespace=cr-at-eol
