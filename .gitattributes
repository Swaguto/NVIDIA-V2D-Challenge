# Universal LFS rules (used by 2+ packages). Package-specific path rules
# live in each subproject's own .gitattributes.

# 3D mesh formats
*.obj filter=lfs diff=lfs merge=lfs -text
*.glb filter=lfs diff=lfs merge=lfs -text
*.stl filter=lfs diff=lfs merge=lfs -text
*.STL filter=lfs diff=lfs merge=lfs -text
*.mtl filter=lfs diff=lfs merge=lfs -text
*.dae filter=lfs diff=lfs merge=lfs -text
# Universal Scene Description (USD)
*.usd filter=lfs diff=lfs merge=lfs -text
*.usda filter=lfs diff=lfs merge=lfs -text
*.usdc filter=lfs diff=lfs merge=lfs -text
*.usdz filter=lfs diff=lfs merge=lfs -text
# Motion data
*.h5 filter=lfs diff=lfs merge=lfs -text
*.hdf5 filter=lfs diff=lfs merge=lfs -text
*.parquet filter=lfs diff=lfs merge=lfs -text
# NumPy / Pickle data
*.npy filter=lfs diff=lfs merge=lfs -text
*.npz filter=lfs diff=lfs merge=lfs -text
*.pkl filter=lfs diff=lfs merge=lfs -text
*.pickle filter=lfs diff=lfs merge=lfs -text
# Model weights
*.onnx filter=lfs diff=lfs merge=lfs -text
*.pt filter=lfs diff=lfs merge=lfs -text
*.safetensors filter=lfs diff=lfs merge=lfs -text

# The episode refinement entrypoint runs in Linux/WSL even from Windows checkouts.
scripts/track3/refine_episode.sh text eol=lf

# Match byte-hashed automatic-recovery sources on Windows and Linux checkouts.
reconstruction/validation/issue6/automatic*.py text eol=lf
reconstruction/validation/issue6/automatic_hands.json text eol=lf
reconstruction/validation/issue6/run_automatic_hand_suite.py text eol=lf
reconstruction/validation/issue6/hand_quality_support.py text eol=lf
reconstruction/validation/issue6/prepare_retained_hand_quality_inputs.py text eol=lf
reconstruction/validation/issue6/run_retained_hand_quality.py text eol=lf
# The existing selector was tested with CRLF; preserve that frozen input exactly.
reconstruction/validation/issue6/wearer_selection.py text eol=crlf
docs/team/reproduction/automatic-hand*.json text eol=lf

# Preserve executable replay/audit helper hashes across Windows/Linux checkouts.
scripts/reproduction/stage_automatic_hands.py text eol=lf
scripts/reproduction/continuous_dex3.py text eol=lf
scripts/reproduction/replay_continuous_dex3_sim6.py text eol=lf
scripts/reproduction/audit_continuous_replay.py text eol=lf
scripts/reproduction/compare_dex3_payloads.py text eol=lf
scripts/reproduction/compare_renderer_outputs.py text eol=lf
scripts/reproduction/make_continuous_review.py text eol=lf
scripts/reproduction/test_continuous_dex3.py text eol=lf
scripts/reproduction/rebuild_motion.py text eol=lf
docs/team/reproduction/continuous-dex3*.json text eol=lf
