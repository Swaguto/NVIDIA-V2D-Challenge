# Absolute host paths. The pack is mounted read-only; outputs must be a different directory.
V2D_DATA_DIR=/home/ubuntu/v2d-data/dex3-review
V2D_OUTPUT_DIR=/home/ubuntu/v2d-outputs/review-001
V2D_IMAGE=v2d-dex3-review:checkpoint
V2D_IK_IMAGE=v2d-dex3-ik:checkpoint
# Set from git rev-parse HEAD before building.
V2D_CODE_COMMIT=unknown
# Read NVIDIA's Isaac Sim license before changing both values to Y and YES.
ACCEPT_EULA=N
OMNI_KIT_ACCEPT_EULA=NO

# Optional full native-cache workflow; see README before enabling this profile.
V2D_WORKSPACE_DIR=/home/ubuntu/v2d-preserved/hand-continuity-repair
V2D_CONTINUITY_IMAGE=v2d-hand-continuity:checkpoint
