# V2D Challenge workspaces — never track these
.venv/
data/
__pycache__/
*.pyc
.DS_Store
results/

# Very large binary artifacts that live in the shared VM, not in git
*.mp4-wip

# secrets / local box state
.docker/
*.key
*.pem

# Root-only rules (upstream video_to_data monorepo). Each subproject
# (reconstruction/, video_ingestion_agent/, robotic_grounding/) has its own
# .gitignore for package-specific artifacts.
**.egg-info

# Editor workspace files
*.code-workspace

# Local direnv overrides (only meaningful at repo root)
.envrc.local
# Local VM-pulled calibration artifacts (untracked)
v2d_ep2_outputs/
v2d_ep2_outputs_v2/
v2d_ep2_outputs_v3/
v2d_ep11_outputs/
v2d_diag_ep2/

# Local Docker migration assets and private configuration
/docker/dex3-review/.env
/docker/dex3-review/*.env
/docker/dex3-review/images/
/dex3-private-data/
/dex3-outputs/
*.docker-image.tar
*.docker-image.tar.gz
